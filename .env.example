# Copy to .env.local for local development. In production set these in the Vercel project (Settings > Environment Variables).
# Never commit real values.

# Google Apps Script web app that stores form submissions in Google Sheets (see docs/google-apps-script.gs)
SHEETS_WEBHOOK_URL=
SHEETS_WEBHOOK_SECRET=

# Optional: next batch date. Default is the 10th of every month (India time).
# BATCH_DAY=10
# BATCH_DATE=2026-12-01

# Optional: Clerk sign-in. Publishable keys are public by design; the secret key (sk_...) is not used and must never be added here.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Optional: tawk.to live chat, e.g. https://tawk.to/chat/<PROPERTY_ID>/<WIDGET_ID>
# NEXT_PUBLIC_TAWK_CHAT_LINK=

# Optional: form submissions allowed per minute per IP
# RATE_LIMIT=8
